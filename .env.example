# Copy this file to .env and fill in your own values. Never commit .env.
#
# Google OAuth credentials — console.cloud.google.com → APIs & Services →
# Credentials → OAuth client ID → Web application.
# Redirect URI must be exactly: <your-domain>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Flask session signing key — generate once with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Must stay the same across restarts/redeploys, or every session gets
# silently invalidated. Never regenerate this at import time in code.
FLASK_SECRET_KEY=
